rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: admins
// Document ID: {uid}
// Fields:
//   - role/metadata managed server-side / Firebase Console only (client read-only self-check)
//
// Collection: users
// Document ID: {uid}
// Fields:
//   - name: string (required, 1..120 chars)
//   - email: string (optional, 0..160 chars, immutable by client)
//   - phone: string (optional, 0..25 chars)
//   - photoURL: string (optional, 0..500 chars)
//   - visitsCount: int (0 on client create, admin-only increment)
//   - clubPlan: null | string (null on client create, admin-only update)
//   - createdAt: timestamp (immutable)
//   - updatedAt: timestamp
//
// Collection: services, plans, barbers, settings
// Document ID: {serviceId}, {planId}, {barberId}, {docId}
// Fields:
//   - Public catalog and barbershop metadata; admin-only writes.
//
// Collection: promotions
// Document ID: {promoId}
// Fields:
//   - active: bool (authenticated users can read active == true; admins read/write all)
//
// Collection: appointments
// Document ID: {appointmentId}
// Fields:
//   - code: string (optional, 0..30 chars)
//   - clientUid: string (required, == request.auth.uid on create, immutable)
//   - clientEmail: string (optional, 0..160 chars)
//   - clientName: string (required, 1..120 chars)
//   - clientPhone: string (required, 8..25 chars)
//   - serviceIds: list<string> (required, 1..15 items)
//   - serviceNames: list<string> (optional, 0..15 items)
//   - barberId: string (required, 1..80 chars)
//   - barberName: string (optional, 0..120 chars)
//   - dateIso: string (required, 8..20 chars)
//   - dateFull: string (optional, 0..80 chars)
//   - time: string (required, 4..10 chars)
//   - totalPrice: number (required, >= 0)
//   - totalDuration: int (required, > 0)
//   - status: string (required, pending on create; admin-managed updates or owner cancellation)
//   - slotId: string (first occupied slot, for legacy compatibility)
//   - slotIds: list<string> (all occupied interval blocks)
//   - createdAt: timestamp (immutable)
//   - updatedAt: timestamp
//
// Collection: availability
// Document ID: {slotId}
// Fields (public, NO PII):
//   - dateIso: string (required, 8..20 chars)
//   - barberId: string (required, 1..80 chars)
//   - time: string (required, 4..10 chars)
//   - status: string (required, 'booked' on create)
//
// Collection: planRequests
// Document ID: {requestId}
// Fields:
//   - clientUid: string (required, == request.auth.uid on client create)
//   - clientEmail: string (optional, 0..160 chars)
//   - clientName: string (required, 1..120 chars)
//   - clientPhone: string (required, 8..25 chars)
//   - planId: string (required, 1..80 chars)
//   - planName: string (required, 1..120 chars)
//   - planPrice: number (optional, >= 0)
//   - waitlist: bool (optional)
//   - status: string (required, 'pending' on create)
//   - createdAt: timestamp (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) || isValidString(data[field], minLen, maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUserCreate(data) {
      return hasOnlyAllowedFields([
          'name', 'email', 'phone', 'photoURL',
          'visitsCount', 'clubPlan', 'createdAt', 'updatedAt'
        ]) &&
        isValidString(data.name, 1, 120) &&
        isValidOptionalString(data, 'email', 0, 160) &&
        isValidOptionalString(data, 'phone', 0, 25) &&
        isValidOptionalString(data, 'photoURL', 0, 500) &&
        (!('visitsCount' in data) || data.visitsCount == 0) &&
        (!('clubPlan' in data) || data.clubPlan == null) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidUserClientUpdate(data) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'photoURL', 'updatedAt'
        ]) &&
        isValidString(data.name, 1, 120) &&
        isValidOptionalString(data, 'phone', 0, 25) &&
        isValidOptionalString(data, 'photoURL', 0, 500) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidAppointmentCreate(data, appointmentId) {
      let firstSlotPath = /databases/$(database)/documents/availability/$(data.slotId);
      let barberPath = /databases/$(database)/documents/barbers/$(data.barberId);
      return hasOnlyAllowedFields([
          'code', 'clientUid', 'clientEmail', 'clientName', 'clientPhone',
          'serviceIds', 'serviceNames', 'requestedBarberId', 'barberId', 'barberName',
          'dateIso', 'dateFull', 'time', 'totalPrice', 'totalDuration',
          'status', 'slotId', 'slotIds', 'createdAt', 'updatedAt'
        ]) &&
        data.clientUid == request.auth.uid &&
        data.status == 'pending' &&
        data.serviceIds is list && data.serviceIds.size() > 0 && data.serviceIds.size() <= 15 &&
        (!('serviceNames' in data) || (data.serviceNames is list && data.serviceNames.size() <= 15)) &&
        isValidString(data.barberId, 1, 80) &&
        exists(barberPath) && get(barberPath).data.active != false &&
        data.barberName == get(barberPath).data.name &&
        (data.requestedBarberId == data.barberId || data.requestedBarberId == 'sem-preferencia') &&
        isValidOptionalString(data, 'requestedBarberId', 1, 80) &&
        isValidOptionalString(data, 'barberName', 0, 120) &&
        isValidString(data.dateIso, 10, 10) &&
        isValidOptionalString(data, 'dateFull', 0, 80) &&
        isValidString(data.time, 5, 5) &&
        data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 100000 &&
        data.totalDuration is int && data.totalDuration > 0 && data.totalDuration <= 480 &&
        isValidString(data.clientName, 1, 120) && isValidString(data.clientPhone, 8, 25) &&
        isValidOptionalString(data, 'clientEmail', 0, 160) &&
        isValidOptionalString(data, 'code', 0, 30) &&
        data.slotIds is list && data.slotIds.size() > 0 && data.slotIds.size() <= 32 &&
        isValidString(data.slotId, 1, 120) &&
        data.slotId == data.slotIds[0] &&
        existsAfter(firstSlotPath) && getAfter(firstSlotPath).data.appointmentId == appointmentId &&
        getAfter(firstSlotPath).data.dateIso == data.dateIso &&
        getAfter(firstSlotPath).data.barberId == data.barberId &&
        getAfter(firstSlotPath).data.time == data.time &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidAppointmentClientCancel(data) {
      return resource.data.clientUid == request.auth.uid &&
        resource.data.status in ['pending', 'confirmed'] && data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidAvailabilityCreate(slotId, data) {
      let appointmentPath = /databases/$(database)/documents/appointments/$(data.appointmentId);
      let idParts = slotId.split('__');
      let timeParts = data.time.split(':');
      let idTimeParts = idParts[2].split('-');
      return hasOnlyAllowedFields([
          'dateIso', 'barberId', 'time', 'appointmentId', 'status', 'createdAt'
        ]) &&
        data.status == 'booked' &&
        isValidString(data.dateIso, 10, 10) && isValidString(data.barberId, 1, 80) &&
        data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        idParts.size() == 3 && idParts[0] == data.dateIso && idParts[1] == data.barberId &&
        timeParts.size() == 2 && idTimeParts.size() == 2 &&
        idTimeParts[0] == timeParts[0] && idTimeParts[1] == timeParts[1] &&
        isValidString(data.appointmentId, 1, 120) &&
        existsAfter(appointmentPath) && getAfter(appointmentPath).data.clientUid == request.auth.uid &&
        getAfter(appointmentPath).data.slotIds.hasAny([slotId]) &&
        getAfter(appointmentPath).data.dateIso == data.dateIso &&
        getAfter(appointmentPath).data.barberId == data.barberId &&
        data.createdAt is timestamp;
    }

    function isValidPlanRequestCreate(data) {
      let planPath = /databases/$(database)/documents/plans/$(data.planId);
      return hasOnlyAllowedFields([
          'clientUid', 'clientEmail', 'clientName', 'clientPhone',
          'planId', 'planName', 'planPrice', 'waitlist', 'status', 'createdAt'
        ]) &&
        data.clientUid == request.auth.uid && data.status == 'pending' &&
        isValidString(data.planId, 1, 80) && isValidString(data.planName, 1, 120) &&
        isValidString(data.clientName, 1, 120) && isValidString(data.clientPhone, 8, 25) &&
        isValidOptionalString(data, 'clientEmail', 0, 160) &&
        data.planPrice is number && data.planPrice >= 0 && data.planPrice <= 100000 &&
        data.waitlist is bool && exists(planPath) &&
        get(planPath).data.active != false && data.planName == get(planPath).data.name &&
        data.planPrice == get(planPath).data.price &&
        data.waitlist == (get(planPath).data.slots <= 0 || get(planPath).data.badge == 'Esgotado') &&
        data.createdAt is timestamp;
    }

    function isPublicAvailability(data) {
      return data.keys().hasOnly([
          'dateIso', 'barberId', 'time', 'appointmentId', 'status', 'createdAt'
        ]) &&
        data.dateIso is string && data.dateIso.size() == 10 &&
        data.barberId is string && data.barberId.size() > 0 && data.barberId.size() <= 80 &&
        data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.status == 'booked';
    }

    function isFirstVisitPromotion(data) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && data.target == 'first_visit' &&
        (!exists(profilePath) || get(profilePath).data.visitsCount == 0);
    }

    function isClubPromotion(data) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && data.target == 'club' &&
        exists(profilePath) && get(profilePath).data.clubPlan != null;
    }

    function hasNoEmailForBroadPromotion(data) {
      return data.target == 'email' || !('targetEmail' in data) || data.targetEmail == '';
    }

    function isEligiblePromotion(data) {
      return isAuthenticated() && data.active == true && hasNoEmailForBroadPromotion(data) && (
        data.target == 'all' ||
        (data.target == 'email' && request.auth.token.email != null &&
          data.targetEmail == request.auth.token.email.lower()) ||
        isFirstVisitPromotion(data) ||
        isClubPromotion(data)
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Admins lookup (read-only self-check; managed via Console / Admin SDK)
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    // User profiles (PII protected; owner read/limited-write, admin full read/update)
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid) && isValidUserCreate(request.resource.data);
      allow update: if isAdmin() || (isOwner(uid) && isValidUserClientUpdate(request.resource.data));
      allow delete: if false;
    }

    // Public catalog & barbershop info (admin-only writes)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow get: if isAdmin() || (docId == 'barbershop' && resource.data.keys().hasOnly([
        'name', 'unit', 'days', 'hours', 'openingTime', 'closingTime',
        'openDays', 'slotIntervalMinutes', 'catalogVersion', 'updatedAt'
      ]));
      allow list: if false;
      allow write: if isAdmin();
    }

    // Promotions (authenticated users can read active promotions; admins manage all)
    match /promotions/{promoId} {
      allow read: if isAdmin() || isEligiblePromotion(resource.data);
      allow write: if isAdmin();
    }

    // Appointments (client creates pending & can cancel pending/confirmed; admin manages all)
    match /appointments/{appointmentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.clientUid == request.auth.uid);
      allow create: if isAuthenticated() && isValidAppointmentCreate(request.resource.data, appointmentId);
      allow update: if isAdmin() || (isAuthenticated() && isValidAppointmentClientCancel(request.resource.data));
      allow delete: if isAdmin();
    }

    // Public availability slot locks (NO PII)
    match /availability/{slotId} {
      allow get: if isAdmin() ||
        !exists(/databases/$(database)/documents/availability/$(slotId)) ||
        isPublicAvailability(resource.data);
      allow list: if isAdmin() || isPublicAvailability(resource.data);
      allow create: if isAuthenticated() && isValidAvailabilityCreate(slotId, request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() &&
        get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.clientUid == request.auth.uid);
    }

    // Club plan interest / waitlist requests
    match /planRequests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.clientUid == request.auth.uid);
      allow create: if isAuthenticated() && isValidPlanRequestCreate(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Default deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
