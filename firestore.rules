rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: admins
// Document ID: {uid}
// Fields:
//   - role/metadata managed server-side / Firebase Console only (client read-only self-check)
//
// Collection: users
// Document ID: {uid}
// Fields:
//   - name: string (required, 1..120 chars)
//   - email: string (optional, 0..160 chars, immutable by client)
//   - phone: string (optional, 0..25 chars)
//   - photoURL: string (optional, 0..500 chars)
//   - visitsCount: int (0 on client create, admin-only increment)
//   - clubPlan: null | string (null on client create, admin-only update)
//   - createdAt: timestamp (immutable)
//   - updatedAt: timestamp
//
// Collection: services, plans, barbers, settings
// Document ID: {serviceId}, {planId}, {barberId}, {docId}
// Fields:
//   - Public catalog and barbershop metadata; admin-only writes.
//
// Collection: promotions
// Document ID: {promoId}
// Fields:
//   - active: bool (authenticated users can read active == true; admins read/write all)
//
// Collection: appointments
// Document ID: {appointmentId}
// Fields:
//   - code: string (optional, 0..30 chars)
//   - clientUid: string (required, == request.auth.uid on create, immutable)
//   - clientEmail: string (optional, 0..160 chars)
//   - clientName: string (required, 1..120 chars)
//   - clientPhone: string (required, 8..25 chars)
//   - serviceIds: list<string> (required, 1..15 items)
//   - serviceNames: list<string> (optional, 0..15 items)
//   - barberId: string (required, 1..80 chars)
//   - barberName: string (optional, 0..120 chars)
//   - dateIso: string (required, 8..20 chars)
//   - dateFull: string (optional, 0..80 chars)
//   - time: string (required, 4..10 chars)
//   - totalPrice: number (required, >= 0)
//   - totalDuration: int (required, > 0)
//   - status: string (required, created/updated by callable functions)
//   - slotId: string (first occupied slot, for legacy compatibility)
//   - slotIds: list<string> (all occupied interval blocks)
//   - createdAt: timestamp (immutable)
//   - updatedAt: timestamp
//
// Collection: availability
// Document ID: {slotId}
// Fields (public, NO PII):
//   - dateIso: string (required, 8..20 chars)
//   - barberId: string (required, 1..80 chars)
//   - time: string (required, 4..10 chars)
//   - status: string (required, 'booked' on create)
//
// Collection: planRequests
// Document ID: {requestId}
// Fields:
//   - clientUid: string (required, == request.auth.uid; written by callable functions)
//   - clientEmail: string (optional, 0..160 chars)
//   - clientName: string (required, 1..120 chars)
//   - clientPhone: string (required, 8..25 chars)
//   - planId: string (required, 1..80 chars)
//   - planName: string (required, 1..120 chars)
//   - planPrice: number (optional, >= 0)
//   - waitlist: bool (optional)
//   - status: string (required, 'pending' on create)
//   - createdAt: timestamp (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) || isValidString(data[field], minLen, maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUserCreate(data) {
      return hasOnlyAllowedFields([
          'name', 'email', 'phone', 'photoURL',
          'visitsCount', 'clubPlan', 'createdAt', 'updatedAt'
        ]) &&
        isValidString(data.name, 1, 120) &&
        isValidOptionalString(data, 'email', 0, 160) &&
        isValidOptionalString(data, 'phone', 0, 25) &&
        isValidOptionalString(data, 'photoURL', 0, 500) &&
        (!('visitsCount' in data) || data.visitsCount == 0) &&
        (!('clubPlan' in data) || data.clubPlan == null) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidUserClientUpdate(data) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'photoURL', 'updatedAt'
        ]) &&
        isValidString(data.name, 1, 120) &&
        isValidOptionalString(data, 'phone', 0, 25) &&
        isValidOptionalString(data, 'photoURL', 0, 500) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isFirstVisitPromotion(data) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && data.target == 'first_visit' &&
        (!exists(profilePath) || get(profilePath).data.visitsCount == 0);
    }

    function isClubPromotion(data) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && data.target == 'club' &&
        exists(profilePath) && get(profilePath).data.clubPlan != null;
    }

    function hasNoEmailForBroadPromotion(data) {
      return data.target == 'email' || !('targetEmail' in data) || data.targetEmail == '';
    }

    function isEligiblePromotion(data) {
      return isAuthenticated() && data.active == true && hasNoEmailForBroadPromotion(data) && (
        data.target == 'all' ||
        (data.target == 'email' && request.auth.token.email != null &&
          data.targetEmail == request.auth.token.email.lower()) ||
        isFirstVisitPromotion(data) ||
        isClubPromotion(data)
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Admins lookup (read-only self-check; managed via Console / Admin SDK)
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    // User profiles (PII protected; owner read/limited-write, admin full read/update)
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid) && isValidUserCreate(request.resource.data);
      allow update: if isAdmin() || (isOwner(uid) && isValidUserClientUpdate(request.resource.data));
      allow delete: if false;
    }

    // Public catalog & barbershop info (admin-only writes)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow get: if docId == 'barbershop' && resource.data.keys().hasOnly([
        'name', 'unit', 'days', 'hours', 'openingTime', 'closingTime',
        'openDays', 'slotIntervalMinutes', 'catalogVersion', 'updatedAt'
      ]);
      allow list: if false;
      allow write: if isAdmin();
    }

    // Promotions (authenticated users can read active promotions; admins manage all)
    match /promotions/{promoId} {
      allow read: if isAdmin() || isEligiblePromotion(resource.data);
      allow write: if isAdmin();
    }

    // Appointments (client creates pending & can cancel pending/confirmed; admin manages all)
    match /appointments/{appointmentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.clientUid == request.auth.uid);
      allow write: if false;
    }

    // Public availability slot locks (NO PII)
    match /availability/{slotId} {
      allow read: if isAdmin() || resource.data.keys().hasOnly([
        'dateIso', 'barberId', 'time', 'status', 'createdAt'
      ]);
      allow write: if false;
    }

    // Club plan interest / waitlist requests
    match /planRequests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.clientUid == request.auth.uid);
      allow create: if false;
      allow update, delete: if false;
    }

    // Default deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
